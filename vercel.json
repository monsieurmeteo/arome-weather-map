{
  "version": 2,
  "name": "arome-weather-map",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/output/maps/(.*).webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}